{:viewport [2200 1400]
 :steps [{:op :click :selector {:fx.plorer/style-classes #{"tree-cell"} :text "tail.skeleton"}}
         {:op :keys :keys [:enter]}
         {:op :wait :selector "#skeletal-workspace" :property :visible :equals true :timeout-ms 30000}
         {:op :click :selector "#skeletal-tree-search"}
         {:op :keys :keys [:t]} {:op :keys :keys [:a]} {:op :keys :keys [:i]} {:op :keys :keys [:l]}
         {:op :click :selector "#skeletal-tree-attachment-05_tail"}
         {:op :click :selector "#skeletal-rigging-weights"}
         {:op :wait :selector "#skeletal-weight-bone-list" :property :visible :equals true :timeout-ms 10000}
         {:op :assert :selector "#skeletal-unbind-bone" :property :managed :equals false}
         {:op :snapshot}
         {:op :click :selector "#skeletal-tree-bone-tail"}
         {:op :assert :selector "#skeletal-workspace" :context-key :editor.skeletal-animation-view/context :state-path [:state :selected] :equals "05_tail"}
         {:op :wait :selector "#skeletal-bind-selected-bones" :property :managed :equals true :timeout-ms 10000}
         {:op :assert :selector "#skeletal-unbind-bone" :property :managed :equals false}
         {:op :snapshot}
         {:op :click :selector "#skeletal-bind-selected-bones"}
         {:op :wait :selector "#skeletal-unbind-bone" :property :managed :equals true :timeout-ms 10000}
         {:op :assert :selector "#skeletal-workspace" :context-key :editor.skeletal-animation-view/context :state-path [:state :weight-bones] :equals #{"tail"}}
         {:op :assert :selector "#skeletal-bind-selected-bones" :property :managed :equals false}
         {:op :snapshot}
         {:op :click :selector "#skeletal-unbind-bone"}
         {:op :wait :selector "#skeletal-bind-selected-bones" :property :managed :equals true :timeout-ms 10000}
         {:op :assert :selector "#skeletal-unbind-bone" :property :managed :equals false}
         {:op :snapshot}
         {:op :keys :keys [:meta :z]}
         {:op :wait :selector "#skeletal-unbind-bone" :property :managed :equals true :timeout-ms 10000}
         {:op :keys :keys [:meta :z]}
         {:op :wait :selector "#skeletal-bind-selected-bones" :property :managed :equals true :timeout-ms 10000}
         {:op :snapshot}]}
