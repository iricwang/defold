{:viewport [2000 1200]
 :steps [{:op :click :selector {:fx.plorer/style-classes #{"tree-cell"} :text "tail.skeleton"}}
         {:op :keys :keys [:enter]}
         {:op :wait :selector "#skeletal-workspace" :property :visible :equals true :timeout-ms 30000}
         {:op :click :selector "#skeletal-tree-search"}
         {:op :keys :keys [:f]} {:op :keys :keys [:o]} {:op :keys :keys [:l]} {:op :keys :keys [:l]} {:op :keys :keys [:o]} {:op :keys :keys [:w]}
         {:op :click :selector "#skeletal-tree-path-05_tail_auto1_follow"}
         {:op :wait :selector "#skeletal-rig-controller-05_tail_auto1_control2" :property :visible :equals true :timeout-ms 10000}
         {:op :assert :selector "#skeletal-rig-controller-05_tail_auto1_control1" :property :text :equals "1"}
         {:op :assert :selector "#skeletal-rig-controller-05_tail_auto1_control2" :property :text :equals "2"}
         {:op :assert :selector "#skeletal-properties-rig-advanced-follow-content" :property :visible :equals false}
         {:op :snapshot}
         {:op :click :selector "#skeletal-rig-controller-05_tail_auto1_control2"}
         {:op :wait :selector "#skeletal-workspace" :context-key :editor.skeletal-animation-view/context :state-path [:state :selected] :equals "05_tail_auto1_control2" :timeout-ms 10000}
         {:op :assert :selector "#skeletal-rig-controller-05_tail_auto1_control2" :property :selected :equals true}
         {:op :assert :selector "#skeletal-properties-rig-identity-content" :property :visible :equals false}
         {:op :snapshot}
         {:op :click :selector "#skeletal-rig-controller-05_tail_auto1_control1"}
         {:op :wait :selector "#skeletal-workspace" :context-key :editor.skeletal-animation-view/context :state-path [:state :selected] :equals "05_tail_auto1_control1" :timeout-ms 10000}
         {:op :click :selector "#skeletal-rig-shape-05_tail_auto1_follow"}
         {:op :wait :selector "#skeletal-properties-rig-advanced-path-content" :property :visible :equals false :timeout-ms 10000}
         {:op :assert :selector "#skeletal-workspace" :context-key :editor.skeletal-animation-view/context :state-path [:state :selected] :equals "05_tail_auto1_path"}
         {:op :snapshot}
         {:op :click :selector "#skeletal-rig-configure-path-05_tail_auto1_follow"}
         {:op :wait :selector "#skeletal-rig-path-05_tail_auto1_follow-length-mode" :property :visible :equals true :timeout-ms 10000}
         {:op :snapshot}]}
