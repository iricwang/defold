local expected = {
    {id="start", t=0, integer=7, number=1.25, text="setup-start"},
    {id="pulse", t=0.4, integer=31, number=4.5, text="override-pulse"},
    {id="pulse", t=0.8, integer=11, number=2.5, text="default-pulse"},
}
local function callback(self, message_id, message, sender)
    if message_id ~= hash("spine_event") then return end
    self.events = self.events + 1
    local e = expected[(self.events-1) % #expected+1]
    assert(message.event_id == hash(e.id), "event id")
    assert(message.animation_id == hash("default"), "animation id")
    assert(math.abs(message.t-e.t)<0.0001, "event time")
    assert(message.integer == e.integer, "event integer")
    assert(math.abs(message.float-e.number)<0.0001, "event float")
    assert(message.string == hash(e.text), "event string")
    assert(message.track == 1, "event track")
    print(string.format("SPINE_WORKFLOW_EVENT %d %s %.3f %d %.2f %s",self.events,e.id,message.t,message.integer,message.float,e.text))
end
function init(self)
    self.events=0
    self.frames=0
    spine.play_anim("#rig", hash("default"), go.PLAYBACK_LOOP_FORWARD, {blend_duration=0}, callback)
end
function update(self, dt)
    self.frames=self.frames+1
    if self.frames >= 420 and self.events >= 12 then
        print("SPINE_WORKFLOW_RUNTIME_OK frames="..self.frames.." events="..self.events)
        sys.exit(0)
    end
end
