{:viewport [2400 1400]
 :steps [{:op :click :selector {:fx.plorer/style-classes #{"tree-cell"} :text "tail.skeleton"}}
         {:op :keys :keys [:enter]}
         {:op :wait :selector "#skeletal-workspace" :property :visible :equals true :timeout-ms 30000}
         {:op :click :selector "#skeletal-tree-search"}
         {:op :keys :keys [:t]}
         {:op :keys :keys [:a]}
         {:op :keys :keys [:i]}
         {:op :keys :keys [:l]}
         {:op :click :selector {:fx.plorer/style-classes #{"tree-cell"} :text "tail"}}
         {:op :assert :selector "#skeletal-tool-dock" :property :visible :equals true}
         {:op :scroll :selector "#skeletal-tool-dock" :delta [-1200 0]}
         {:op :click :selector "#skeletal-space-world"}
         {:op :assert :selector "#skeletal-space-world" :property :selected :equals true}
         {:op :scroll :selector "#skeletal-tool-dock" :delta [1200 0]}
         {:op :click :selector "#skeletal-tree-attachment-05_tail"}
         {:op :assert :selector "#skeletal-workspace" :context-key :editor.skeletal-animation-view/context :state-path [:state :selected-attachment] :equals ["05_tail" "05_tail" "default"]}
         {:op :snapshot}
         {:op :click :selector "#skeletal-tree-slot-05_tail"}
         {:op :assert :selector "#skeletal-workspace" :context-key :editor.skeletal-animation-view/context :state-path [:state :selected-attachment] :equals nil}
         {:op :click :selector "#skeletal-tree-bone-tail"}
         {:op :remember :selector "#skeletal-palette-rotation" :property :text :as :numeric-before}
         {:op :drag :button :primary :path [{:selector "#skeletal-palette-rotation" :at [0.5 0.85]} {:selector "#skeletal-palette-rotation" :at [0.5 0.1]}]}
         {:op :assert :selector "#skeletal-palette-rotation" :property :text :differs-from :numeric-before}
         {:op :assert :selector "#skeletal-workspace" :context-key :editor.skeletal-animation-view/context :state-path [:state :drag] :equals nil}
         {:op :keys :keys [:meta :z]}
         {:op :click :selector "#skeletal-tool-rotate"}
         {:op :assert :selector "#skeletal-tool-rotate" :property :selected :equals true}
         {:op :remember :selector "#skeletal-palette-rotation" :property :text :as :rotation}
         {:op :drag :button :primary :path [{:selector "#skeletal-canvas" :at [0.9 0.12]}
                                           {:selector "#skeletal-canvas" :at [0.85 0.15]}
                                           {:selector "#skeletal-canvas" :at [0.8 0.18]}]}
         {:op :assert :selector "#skeletal-workspace" :context-key :editor.skeletal-animation-view/context :state-path [:state :selected] :equals "tail"}
         {:op :assert :selector "#skeletal-palette-rotation" :property :text :differs-from :rotation}
         {:op :keys :keys [:meta :z]}
         {:op :assert :selector "#skeletal-workspace" :context-key :editor.skeletal-animation-view/context :state-path [:state :selected] :equals "tail"}
         {:op :click :button :secondary :selector "#skeletal-canvas" :at [0.9 0.12]}
         {:op :assert :selector "#skeletal-tool-move" :property :selected :equals true}
         {:op :click :button :secondary :selector "#skeletal-canvas" :at [0.9 0.12]}
         {:op :assert :selector "#skeletal-tool-rotate" :property :selected :equals true}
         {:op :remember :selector "#skeletal-workspace" :context-key :editor.skeletal-animation-view/context :state-path [:state :pan-x] :as :pan}
         {:op :drag :button :secondary :path [{:selector "#skeletal-canvas" :at [0.2 0.12]}
                                             {:selector "#skeletal-canvas" :at [0.3 0.14]}
                                             {:selector "#skeletal-canvas" :at [0.4 0.16]}]}
         {:op :assert :selector "#skeletal-workspace" :context-key :editor.skeletal-animation-view/context :state-path [:state :pan-x] :differs-from :pan}
         {:op :assert :selector "#skeletal-tool-rotate" :property :selected :equals true}
         {:op :click :selector "#skeletal-mode"}
         {:op :keys :window-index 1 :keys [:down]}
         {:op :keys :window-index 1 :keys [:enter]}
         {:op :assert :selector "#skeletal-mode" :property :value :equals "animate"}
         {:op :snapshot}
         {:op :click :selector "#skeletal-canvas" :at [0.9 0.12]}
         {:op :keys :keys [:space]}
         {:op :assert :selector "#skeletal-workspace" :context-key :editor.skeletal-animation-view/context :state-path [:state :playing] :equals true}
         {:op :keys :keys [:space]}
         {:op :assert :selector "#skeletal-workspace" :context-key :editor.skeletal-animation-view/context :state-path [:state :playing] :equals false}]}
