local function label(text, x, y, scale)
    local node = gui.new_text_node(vmath.vector3(x, y, 0), text)
    gui.set_font(node, "default")
    gui.set_scale(node, vmath.vector3(scale))
    return node
end

function init(self)
    msg.post(".", "acquire_input_focus")
    local background = gui.new_box_node(vmath.vector3(160, 120, 0), vmath.vector3(320, 240, 0))
    gui.set_color(background, vmath.vector4(0.07, 0.09, 0.14, 1))
    label("BACKGROUND / GPU", 160, 210, 0.8)
    label("Actual runtime - no desktop input", 160, 185, 0.5)
    self.button = gui.new_box_node(vmath.vector3(160, 120, 0), vmath.vector3(120, 48, 0))
    gui.set_id(self.button, "verify_button")
    gui.set_color(self.button, vmath.vector4(0.16, 0.38, 0.78, 1))
    self.title = label("CLICK TO VERIFY", 160, 120, 0.6)
    self.handle = gui.new_box_node(vmath.vector3(80, 55, 0), vmath.vector3(28, 28, 0))
    gui.set_id(self.handle, "drag_handle")
    gui.set_color(self.handle, vmath.vector4(1, 0.6, 0.18, 1))
    label("Drag the orange square", 205, 55, 0.5)
    self.clicks = 0
    print("AUTOMATION_READY")
end

function update(self, dt)
    local area = window.get_safe_area()
    local state = string.format("SAFE_AREA %.0f %.0f %.0f %.0f", area.inset_top, area.inset_right,
        area.inset_bottom, area.inset_left)
    if self.safe_area ~= state then
        self.safe_area = state
        print(state)
    end
end

function on_input(self, id, action)
    if id == hash("click") then
        if action.pressed and gui.pick_node(self.button, action.x, action.y) then
            self.clicks = self.clicks + 1
            gui.set_color(self.button, vmath.vector4(0.1, 0.65, 0.4, 1))
            gui.set_text(self.title, "VERIFIED " .. self.clicks)
            print("BUTTON_CLICKED " .. self.clicks)
        end
        if action.pressed and gui.pick_node(self.handle, action.x, action.y) then self.dragging = true end
        if self.dragging then gui.set_position(self.handle, vmath.vector3(action.x, action.y, 0)) end
        if action.released then
            if self.dragging then print("DRAG_COMPLETE " .. action.screen_x .. " " .. action.screen_y) end
            self.dragging = false
            print("POINTER_RELEASED")
        end
    elseif id == hash("wheel") and action.pressed then
        print("WHEEL_RECEIVED")
    elseif id == hash("key") and action.pressed then
        print("KEY_RECEIVED")
    elseif id == hash("text") then
        print("TEXT_RECEIVED " .. action.text)
    end
end
